# Copy this file to .env and fill in real values. .env is gitignored.

# fal.ai — Seedance 2.0 video generation
# Get from: https://fal.ai/dashboard/keys
FAL_KEY=

# Airtable + Google Drive are accessed via pre-authenticated Claude Code MCPs
# (mcp__d5784726__* for Airtable, mcp__d75a2d06__* for Drive).
# No API keys needed here — only the Drive folder ID below:

# Google Drive — target folder for generated video uploads
DRIVE_OUTPUT_FOLDER_ID=
