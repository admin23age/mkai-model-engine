# Copy this file to .env and fill in real values. .env is gitignored.

# fal.ai — Seedance 2.0 video generation
# Get from: https://fal.ai/dashboard/keys
FAL_KEY=

# BytePlus ModelArk — direct Seedance access (BACKUP, evaluate at day 28)
# Console: https://console.byteplus.com
BYTEPLUS_API_KEY=
BYTEPLUS_ENDPOINT_ID=
BYTEPLUS_REGION=ap-southeast-1

# Airtable — DDD Content Queue
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

# Google Drive — generated video storage
# Service account JSON path (file itself is gitignored)
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/drive-service-account.json
DRIVE_OUTPUT_FOLDER_ID=
