    {
      "parameters": {
        "jsCode": "// Admin Supervisor Task Classifier\n\nconst input = $input.first().json;\nconst now = new Date();\n\nlet taskType = 'unknown';\nlet taskData = {};\nlet source = 'unknown';\n\n// Check trigger source\nif (input.body) {\n  // Webhook trigger\n  source = 'webhook';\n  taskType = input.body.task_type || 'manual';\n  taskData = input.body;\n} else {\n  // Scheduled trigger - determine by time\n  const hour = now.getHours();\n  const minute = now.getMinutes();\n  \n  if (hour === 6 && minute < 15) {\n    taskType = 'calendar_block';\n    source = 'schedule_6am';\n  } else if (hour === 8 && minute < 15) {\n    taskType = 'social_post_ddd';\n    source = 'schedule_8am';\n  } else if (hour === 9 && minute < 15) {\n    taskType = 'social_post_mkai';\n    source = 'schedule_9am';\n  } else {\n    // Default to email check (every 15 min)\n    taskType = 'email_check';\n    source = 'schedule_15min';\n  }\n  \n  taskData = { scheduled: true, trigger_time: now.toISOString() };\n}\n\nconst taskId = `admin_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;\n\nreturn {\n  task_id: taskId,\n  task_type: taskType,\n  source: source,\n  task_data: taskData,\n  timestamp: now.toISOString(),\n  status: 'classifying'\n};"
      },
