            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "conditions": [
                  {"leftValue": "={{ $json.task_type }}", "rightValue": "social_post", "operator": {"type": "string", "operation": "equals"}},
                  {"leftValue": "={{ $json.brand }}", "rightValue": "dorothy_dean_designs", "operator": {"type": "string", "operation": "equals"}}
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "DDD Social"
            },
