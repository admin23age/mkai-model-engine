    {
      "parameters": {
        "jsCode": "// Determine marketing task type based on trigger\n\nconst now = new Date();\nconst hour = now.getHours();\nconst day = now.getDay(); // 0 = Sunday, 1 = Monday\nconst input = $input.first().json;\n\nlet taskType = 'unknown';\nlet brand = '';\n\n// Check if webhook with specific task\nif (input.body && input.body.task_type) {\n  taskType = input.body.task_type;\n  brand = input.body.brand || '';\n} else if (day === 1 && hour === 7) {\n  // Monday 7 AM = SEO Report\n  taskType = 'seo_report';\n} else if (hour === 8) {\n  // 8 AM = DDD Social\n  taskType = 'social_post';\n  brand = 'dorothy_dean_designs';\n} else if (hour === 9) {\n  // 9 AM = MKAI Social\n  taskType = 'social_post';\n  brand = 'mankind_ai';\n} else {\n  // Default based on input\n  taskType = input.task_type || 'social_post';\n  brand = input.brand || 'mankind_ai';\n}\n\nreturn {\n  task_id: `mkt_${Date.now()}`,\n  task_type: taskType,\n  brand: brand,\n  timestamp: now.toISOString()\n};"
      },
      "id": "classify-task",
      "name": "Classify Marketing Task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 460]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
