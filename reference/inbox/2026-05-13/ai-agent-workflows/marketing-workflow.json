    {
      "parameters": {
        "jsCode": "// Generate SEO Analysis Report\n// Analyzes mankindaitech.com and client websites\n\nconst websites = [\n  { name: 'Man Kind AI Tech', url: 'https://www.mankindaitech.com', type: 'primary' },\n  // Add client websites here from Airtable\n];\n\n// SEO Check Areas\nconst seoChecklist = [\n  'Page titles and meta descriptions',\n  'Header structure (H1, H2, H3)',\n  'Image alt tags',\n  'Internal linking',\n  'Mobile responsiveness',\n  'Page load speed',\n  'SSL certificate',\n  'Sitemap presence',\n  'Robots.txt',\n  'Schema markup'\n];\n\nreturn {\n  task_type: 'seo_report',\n  websites: websites,\n  checklist: seoChecklist,\n  report_date: new Date().toISOString(),\n  status: 'generating'\n};"
      },
      "id": "prepare-seo-report",
      "name": "Prepare SEO Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 560]
    },
    {
      "parameters": {
        "jsCode": "// Process DDD social post\nconst content = $input.first().json;\n\nif (!content || !content.fields) {\n  return {\n    status: 'skipped',\n    reason: 'No ready content found for Dorothy Dean Designs',\n    timestamp: new Date().toISOString()\n  };\n}\n\nconst post = content.fields;\n\nreturn {\n  brand: 'dorothy_dean_designs',\n  caption: post.Caption || post.Content,\n  image_url: post.Image?.[0]?.url || null,\n  hashtags: post.Hashtags || '#DorotyDeanDesigns #FaithBasedFashion #WearYourFaith',\n  scheduled_time: new Date().toISOString(),\n  record_id: content.id,\n  status: 'ready_to_post'\n};"
      },
      "id": "process-ddd-post",
      "name": "Process DDD Post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "jsCode": "// Process MKAI social post\nconst content = $input.first().json;\n\nif (!content || !content.fields) {\n  return {\n    status: 'skipped',\n    reason: 'No ready content found for Man Kind AI',\n    timestamp: new Date().toISOString()\n  };\n}\n\nconst post = content.fields;\n\nreturn {\n  brand: 'mankind_ai',\n  caption: post.Caption || post.Content,\n  image_url: post.Image?.[0]?.url || null,\n  hashtags: post.Hashtags || '#ManKindAI #AIConsulting #BusinessAutomation',\n  scheduled_time: new Date().toISOString(),\n  record_id: content.id,\n  status: 'ready_to_post'\n};"
      },
