        "sendTo": "={{ $('Parse Maintenance Request').first().json.client_email }}",
        "subject": "=✅ Maintenance Request Received - {{ $('Parse Maintenance Request').first().json.request_type }}",
        "emailType": "html",
        "message": "=<h2>We've Received Your Request</h2>\n\n<p>Hi {{ $('Parse Maintenance Request').first().json.client_name }},</p>\n\n<p>Thank you for reaching out. We've received your website maintenance request and will begin working on it shortly.</p>\n\n<h3>Request Details:</h3>\n<ul>\n  <li><strong>Type:</strong> {{ $('Parse Maintenance Request').first().json.request_type }}</li>\n  <li><strong>Priority:</strong> {{ $('Parse Maintenance Request').first().json.priority }}</li>\n  <li><strong>Request ID:</strong> {{ $('Parse Maintenance Request').first().json.task_id }}</li>\n</ul>\n\n<p><strong>Your Request:</strong></p>\n<blockquote>{{ $('Parse Maintenance Request').first().json.description }}</blockquote>\n\n<h3>What's Next?</h3>\n<p>Our team will review your request and get back to you within 24-48 business hours. For urgent issues, we prioritize accordingly.</p>\n\n<p>If you have any questions, reply to this email or contact us at support@mankindaitech.com.</p>\n\n<p>Best regards,<br>\nMan Kind AI Tech Support Team</p>"
      },
