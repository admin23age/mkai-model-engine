    {
      "parameters": {
        "jsCode": "// Parse incoming maintenance request\nconst input = $input.first().json;\nconst body = input.body || input;\n\nconst request = {\n  task_id: `maint_${Date.now()}`,\n  client_email: body.client_email || body.from_email || '',\n  client_name: body.client_name || body.from_name || '',\n  website_url: body.website_url || body.website || '',\n  request_type: body.request_type || 'general',\n  description: body.description || body.message || body.snippet || '',\n  priority: body.priority || 'normal',\n  source: body.source || 'email',\n  timestamp: new Date().toISOString(),\n  status: 'received'\n};\n\n// Classify request type\nconst desc = request.description.toLowerCase();\n\nif (desc.includes('urgent') || desc.includes('emergency') || desc.includes('down') || desc.includes('broken')) {\n  request.priority = 'high';\n  request.request_type = 'urgent_fix';\n} else if (desc.includes('update') || desc.includes('change') || desc.includes('edit')) {\n  request.request_type = 'content_update';\n} else if (desc.includes('new page') || desc.includes('add page') || desc.includes('create')) {\n  request.request_type = 'new_content';\n} else if (desc.includes('image') || desc.includes('photo') || desc.includes('logo')) {\n  request.request_type = 'media_update';\n} else if (desc.includes('bug') || desc.includes('error') || desc.includes('not working')) {\n  request.request_type = 'bug_fix';\n  request.priority = 'high';\n}\n\nreturn request;"
      },
      "id": "parse-request",
      "name": "Parse Maintenance Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
