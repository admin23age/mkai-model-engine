{
  "name": "DD Chat Lead to Zoho Flow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chat-lead-capture",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Lead Capture Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "chat-lead-capture"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json.body || $input.first().json;\n\nconst name = input.name || input.leadName || 'Unknown';\nconst email = input.email || '';\nconst phone = input.phone || '';\nconst sessionId = input.sessionId || `lead_${Date.now()}`;\nconst source = input.source || 'Website Chat';\nconst notes = input.notes || input.message || '';\n\nreturn {\n  json: {\n    name,\n    email,\n    phone,\n    sessionId,\n    source,\n    notes,\n    capturedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "normalize-data",
      "name": "Normalize Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "https://flow.zoho.com/919301546/flow/webhook/incoming?zapikey=1001.ab3dd54f5b681e2d14ff04d51b620371.87b5c41d91f9ae9b15afe67577908d3c&isdebug=false",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $json.name }}\",\n  \"email\": \"{{ $json.email }}\",\n  \"phone\": \"{{ $json.phone }}\",\n  \"source\": \"{{ $json.source }}\",\n  \"notes\": \"{{ $json.notes }}\"\n}"
      },
      "id": "zoho-flow",
      "name": "Trigger Zoho Flow (Create Lead)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "apphncIswjpBhPcqz"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "tble1FcYJ4wXtjGfG"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "flde0JGCgqowlywPh": "={{ $('Normalize Lead Data').item.json.name }}",
            "fldi3zlyGsruvMfGJ": "={{ $('Normalize Lead Data').item.json.email }}",
            "fldIJmkC8Lobc6WI4": "={{ $('Normalize Lead Data').item.json.phone }}",
            "fldxaMc3YGG84SZe7": "={{ $('Normalize Lead Data').item.json.sessionId }}",
            "fldCOjVvtno5wnuDx": "={{ $('Normalize Lead Data').item.json.source }}",
            "fldAEm23sLZMeNEb7": "={{ $('Normalize Lead Data').item.json.notes }}",
            "fldz5g8mdNEB9zZNq": true
          }
        }
      },
      "id": "save-to-airtable",
      "name": "Save Lead to Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [900, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Personal Access Token"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Lead captured successfully\",\n  \"leadId\": \"{{ $json.id }}\"\n}"
      },
      "id": "respond",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Lead Capture Webhook": {
      "main": [[{"node": "Normalize Lead Data", "type": "main", "index": 0}]]
    },
    "Normalize Lead Data": {
      "main": [[{"node": "Trigger Zoho Flow (Create Lead)", "type": "main", "index": 0}]]
    },
    "Trigger Zoho Flow (Create Lead)": {
      "main": [[{"node": "Save Lead to Airtable", "type": "main", "index": 0}]]
    },
    "Save Lead to Airtable": {
      "main": [[{"node": "Respond Success", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
