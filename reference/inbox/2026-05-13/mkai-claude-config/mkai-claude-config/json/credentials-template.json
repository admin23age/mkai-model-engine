{
  "_description": "MKAI Credentials Template - DO NOT STORE ACTUAL SECRETS HERE",
  "_warning": "This is a TEMPLATE only. Store real credentials in n8n Credentials Store or environment variables.",
  "_version": "1.0.0",

  "instructions": {
    "n8n": "Add credentials via n8n UI: Settings > Credentials > Add Credential",
    "environment": "Set via PowerShell: $env:VARIABLE_NAME = 'value'",
    "claude_code": "Add to ~/.claude.json or project .env file"
  },

  "required_credentials": {
    "airtable": {
      "type": "API Key",
      "env_var": "MKAI_AIRTABLE_API_KEY",
      "n8n_credential_type": "airtableTokenApi",
      "get_from": "https://airtable.com/create/tokens",
      "scopes_needed": [
        "data.records:read",
        "data.records:write",
        "schema.bases:read"
      ]
    },

    "gmail": {
      "type": "OAuth2",
      "env_var": "N/A - use OAuth flow",
      "n8n_credential_type": "gmailOAuth2",
      "get_from": "https://console.cloud.google.com",
      "scopes_needed": [
        "https://www.googleapis.com/auth/gmail.readonly",
        "https://www.googleapis.com/auth/gmail.send",
        "https://www.googleapis.com/auth/gmail.modify"
      ]
    },

    "google_calendar": {
      "type": "OAuth2",
      "env_var": "N/A - use OAuth flow",
      "n8n_credential_type": "googleCalendarOAuth2Api",
      "get_from": "https://console.cloud.google.com",
      "scopes_needed": [
        "https://www.googleapis.com/auth/calendar",
        "https://www.googleapis.com/auth/calendar.events"
      ]
    },

    "zoho_desk": {
      "type": "OAuth2",
      "env_var": "N/A - use OAuth flow",
      "n8n_credential_type": "zohoOAuth2Api",
      "get_from": "https://api-console.zoho.com",
      "scopes_needed": [
        "Desk.tickets.ALL",
        "Desk.contacts.READ"
      ]
    },

    "zoho_crm": {
      "type": "OAuth2",
      "env_var": "N/A - use OAuth flow",
      "n8n_credential_type": "zohoOAuth2Api",
      "get_from": "https://api-console.zoho.com",
      "scopes_needed": [
        "ZohoCRM.modules.ALL"
      ]
    },

    "google_gemini": {
      "type": "API Key",
      "env_var": "MKAI_GEMINI_API_KEY",
      "n8n_credential_type": "googlePalmApi",
      "get_from": "https://aistudio.google.com/app/apikey"
    },

    "n8n_api": {
      "type": "API Key",
      "env_var": "MKAI_N8N_API_KEY",
      "n8n_credential_type": "N/A - used for external calls",
      "get_from": "n8n Settings > API > Create API Key"
    }
  },

  "environment_template": {
    "_comment": "Copy these to your .env file or set in PowerShell",
    "MKAI_AIRTABLE_API_KEY": "pat...",
    "MKAI_GEMINI_API_KEY": "AI...",
    "MKAI_N8N_API_KEY": "n8n_api_...",
    "MKAI_OWNER_EMAIL": "support@mankindaitech.com",
    "MKAI_TIMEZONE": "America/New_York"
  },

  "n8n_credentials_checklist": [
    "☐ Airtable Token API",
    "☐ Gmail OAuth2",
    "☐ Google Calendar OAuth2", 
    "☐ Zoho OAuth2 (for Desk)",
    "☐ Zoho OAuth2 (for CRM)",
    "☐ Google Gemini API"
  ]
}
