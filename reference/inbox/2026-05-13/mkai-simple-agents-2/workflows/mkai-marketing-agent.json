      "parameters": {
        "jsCode": "// Process social content for posting\nconst content = $input.first().json;\n\nif (!content || !content.fields) {\n  return {\n    status: 'skipped',\n    reason: 'No ready content found',\n    brand: $('Classify Marketing Task').first().json.brand\n  };\n}\n\nconst post = content.fields;\n\nreturn {\n  record_id: content.id,\n  brand: post.Brand || $('Classify Marketing Task').first().json.brand,\n  caption: post.Caption || post.Content || '',\n  image_url: post.Image?.[0]?.url || null,\n  hashtags: post.Hashtags || '',\n  status: 'ready_to_post'\n};"
      },
