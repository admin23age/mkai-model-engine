              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "conditions": [
                  {"leftValue": "={{ $json.task_type }}", "rightValue": "social_post", "operator": {"type": "string", "operation": "equals"}},
