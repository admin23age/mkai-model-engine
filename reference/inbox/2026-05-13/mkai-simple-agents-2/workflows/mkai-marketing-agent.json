    {
      "parameters": {
        "jsCode": "// Marketing Agent - Determine task type\n\nconst input = $input.first().json;\nconst body = input.body || input;\nconst now = new Date();\nconst hour = now.getHours();\nconst day = now.getDay(); // 0=Sun, 1=Mon\n\nlet taskType = body.task_type || 'auto';\nlet brand = body.brand || '';\n\n// Auto-determine based on schedule\nif (taskType === 'auto') {\n  if (day === 1 && hour === 7) {\n    taskType = 'seo_report';\n  } else if (hour === 8) {\n    taskType = 'social_post';\n    brand = 'dorothy_dean_designs';\n  } else if (hour === 9) {\n    taskType = 'social_post';\n    brand = 'mankind_ai';\n  } else {\n    taskType = body.task_type || 'social_post';\n    brand = body.brand || 'mankind_ai';\n  }\n}\n\nreturn {\n  task_id: body.task_id || `mkt_${Date.now()}`,\n  task_type: taskType,\n  brand: brand,\n  data: body,\n  timestamp: now.toISOString()\n};"
      },
      "id": "classify-task",
      "name": "Classify Marketing Task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 500]
    },
