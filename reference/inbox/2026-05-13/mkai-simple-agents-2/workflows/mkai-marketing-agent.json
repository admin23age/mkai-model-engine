      "parameters": {
        "jsCode": "// SEO Report Generator\n\nconst websites = [\n  { name: 'Man Kind AI Tech', url: 'https://www.mankindaitech.com' },\n  { name: 'Dorothy Dean Designs', url: 'https://www.dorothydeandesigns.com' }\n];\n\nconst seoChecklist = [\n  'Page titles and meta descriptions',\n  'Header structure (H1, H2, H3)',\n  'Image alt tags',\n  'Mobile responsiveness',\n  'Page load speed',\n  'Internal linking',\n  'Schema markup',\n  'SSL certificate',\n  'Sitemap presence'\n];\n\nreturn {\n  task_type: 'seo_report',\n  websites: websites,\n  checklist: seoChecklist,\n  report_date: new Date().toISOString()\n};"
      },
