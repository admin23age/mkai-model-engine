{
  "name": "MKAI Supervisor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mkai-supervisor",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "mkai-supervisor"
    },
    {
      "parameters": {
        "jsCode": "// MKAI Supervisor - Routes all incoming requests\n\nconst input = $input.first().json;\nconst body = input.body || input;\n\nconst taskId = `mkai_${Date.now()}_${Math.random().toString(36).substr(2, 6)}`;\n\n// Determine task type and destination\nlet destination = 'unknown';\nlet taskType = body.task_type || 'auto_classify';\n\n// If task_type provided, use it directly\nif (body.task_type) {\n  if (['calendar_block', 'email_route', 'maintenance'].includes(body.task_type)) {\n    destination = 'admin';\n  } else if (['lead', 'new_client', 'quote', 'discovery'].includes(body.task_type)) {\n    destination = 'sales';\n  } else if (['support', 'ticket', 'help', 'issue'].includes(body.task_type)) {\n    destination = 'customer_service';\n  } else if (['seo', 'social_post', 'marketing'].includes(body.task_type)) {\n    destination = 'marketing';\n  }\n}\n\n// Auto-classify based on content if no task_type\nif (destination === 'unknown' && body.content) {\n  const content = body.content.toLowerCase();\n  \n  if (content.includes('pricing') || content.includes('interested') || content.includes('quote')) {\n    destination = 'sales';\n    taskType = 'lead';\n  } else if (content.includes('help') || content.includes('issue') || content.includes('problem')) {\n    destination = 'customer_service';\n    taskType = 'support';\n  } else if (content.includes('maintenance') || content.includes('update my site')) {\n    destination = 'admin';\n    taskType = 'maintenance';\n  } else if (content.includes('seo') || content.includes('social')) {\n    destination = 'marketing';\n    taskType = 'marketing';\n  }\n}\n\nreturn {\n  task_id: taskId,\n  task_type: taskType,\n  destination: destination,\n  source: body.source || 'webhook',\n  data: body,\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "classify-request",
      "name": "Classify Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "conditions": [{"leftValue": "={{ $json.destination }}", "rightValue": "admin", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Admin Agent"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "conditions": [{"leftValue": "={{ $json.destination }}", "rightValue": "sales", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Sales Agent"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "conditions": [{"leftValue": "={{ $json.destination }}", "rightValue": "customer_service", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Customer Service Agent"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "conditions": [{"leftValue": "={{ $json.destination }}", "rightValue": "marketing", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Marketing Agent"
            }
          ],
          "fallbackOutput": {"renameOutput": true, "outputKey": "Unknown"}
        },
        "options": {}
      },
