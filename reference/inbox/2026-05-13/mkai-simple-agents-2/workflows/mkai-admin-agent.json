    {
      "parameters": {
        "jsCode": "// Classify each email and determine routing\nconst emails = $input.all();\nconst results = [];\n\nconst salesPatterns = ['pricing', 'price', 'cost', 'quote', 'interested', 'services', 'consultation'];\nconst supportPatterns = ['help', 'issue', 'problem', 'broken', 'not working', 'error', 'bug'];\nconst maintenancePatterns = ['update', 'change', 'edit', 'maintenance', 'website change'];\nconst spamPatterns = ['unsubscribe', 'opt-out', 'viagra', 'casino', 'lottery'];\n\nfor (const item of emails) {\n  const email = item.json;\n  const subject = (email.subject || '').toLowerCase();\n  const snippet = (email.snippet || '').toLowerCase();\n  const content = subject + ' ' + snippet;\n  \n  let destination = 'owner';\n  let classification = 'unknown';\n  \n  // Check patterns\n  if (spamPatterns.some(p => content.includes(p))) {\n    destination = 'archive';\n    classification = 'spam';\n  } else if (salesPatterns.some(p => content.includes(p))) {\n    destination = 'sales';\n    classification = 'sales_inquiry';\n  } else if (supportPatterns.some(p => content.includes(p))) {\n    destination = 'customer_service';\n    classification = 'support_request';\n  } else if (maintenancePatterns.some(p => content.includes(p))) {\n    destination = 'maintenance';\n    classification = 'maintenance_request';\n  }\n  \n  results.push({\n    email_id: email.id,\n    from: email.from,\n    subject: email.subject,\n    snippet: email.snippet,\n    classification: classification,\n    destination: destination\n  });\n}\n\nreturn results.map(r => ({ json: r }));"
      },
