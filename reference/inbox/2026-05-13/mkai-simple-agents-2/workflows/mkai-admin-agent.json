    {
      "parameters": {
        "jsCode": "// Admin Agent - Classify task type\n\nconst input = $input.first().json;\nconst body = input.body || input;\nconst now = new Date();\nconst hour = now.getHours();\n\nlet taskType = body.task_type || 'auto';\n\n// Auto-determine based on trigger\nif (taskType === 'auto') {\n  if (hour === 6) {\n    taskType = 'calendar_block';\n  } else {\n    taskType = 'email_route';\n  }\n}\n\nreturn {\n  task_id: body.task_id || `admin_${Date.now()}`,\n  task_type: taskType,\n  data: body.data ? JSON.parse(body.data) : body,\n  timestamp: now.toISOString()\n};"
      },
      "id": "classify-task",
      "name": "Classify Admin Task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 400]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "conditions": [{"leftValue": "={{ $json.task_type }}", "rightValue": "calendar_block", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Calendar Block"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "conditions": [{"leftValue": "={{ $json.task_type }}", "rightValue": "email_route", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Email Route"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "conditions": [{"leftValue": "={{ $json.task_type }}", "rightValue": "maintenance", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Maintenance"
            }
          ],
          "fallbackOutput": {"renameOutput": true, "outputKey": "Email Route"}
        },
        "options": {}
      },
