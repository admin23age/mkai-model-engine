    {
      "parameters": {
        "jsCode": "// Calendar Block - 48 hours ahead\n// Business hours: 9 AM - 5 PM EST, Monday-Friday\n\nconst now = new Date();\nconst slots = [];\n\n// Start from tomorrow 9 AM\nconst start = new Date(now);\nstart.setDate(start.getDate() + 1);\nstart.setHours(9, 0, 0, 0);\n\n// End 48 hours from now at 5 PM\nconst end = new Date(now);\nend.setDate(end.getDate() + 2);\nend.setHours(17, 0, 0, 0);\n\nlet current = new Date(start);\n\nwhile (current < end) {\n  const hour = current.getHours();\n  const day = current.getDay();\n  \n  // Skip weekends, only business hours\n  if (day >= 1 && day <= 5 && hour >= 9 && hour < 17) {\n    slots.push({\n      start: current.toISOString(),\n      end: new Date(current.getTime() + 30 * 60 * 1000).toISOString(),\n      summary: '🔒 Focus Time (Auto-blocked)',\n      description: 'Auto-blocked by MKAI Admin Agent'\n    });\n  }\n  current.setMinutes(current.getMinutes() + 30);\n}\n\nreturn {\n  action: 'calendar_block',\n  slots_to_create: slots.length,\n  slots: slots,\n  timestamp: now.toISOString()\n};"
      },
      "id": "calc-calendar-blocks",
      "name": "Calculate Calendar Blocks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 200]
    },
    {
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {"__rl": true, "value": "primary", "mode": "list"},
        "returnAll": false,
        "limit": 100,
        "options": {
          "timeMin": "={{ $json.slots[0]?.start }}",
          "timeMax": "={{ $json.slots[$json.slots.length - 1]?.end }}",
          "singleEvents": true
        }
      },
      "id": "get-existing-events",
      "name": "Get Existing Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [1200, 200],
      "credentials": {"googleCalendarOAuth2Api": {"id": "", "name": "Google Calendar"}}
    },
    {
      "parameters": {
        "jsCode": "// Filter out slots that overlap with existing events\nconst blockData = $('Calculate Calendar Blocks').first().json;\nconst existingEvents = $('Get Existing Events').all().map(e => e.json);\n\nconst freeSlots = blockData.slots.filter(slot => {\n  const slotStart = new Date(slot.start);\n  const slotEnd = new Date(slot.end);\n  \n  return !existingEvents.some(event => {\n    const eventStart = new Date(event.start?.dateTime || event.start?.date);\n    const eventEnd = new Date(event.end?.dateTime || event.end?.date);\n    return slotStart < eventEnd && slotEnd > eventStart;\n  });\n});\n\nreturn freeSlots.map(slot => ({ json: slot }));"
      },
      "id": "filter-free-slots",
      "name": "Filter Free Slots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1420, 200]
    },
